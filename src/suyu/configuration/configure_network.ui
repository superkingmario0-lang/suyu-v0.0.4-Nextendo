         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QLineEdit" name="network_replacement_host">
          <property name="placeholderText">
           <string>Leave empty to block Nintendo servers</string>
          </property>
          <property name="toolTip">
           <string>Nintendo's own online servers cannot be reached, so games asking for them are normally refused. Enter the hostname of a replacement network (for example a community server such as Nextendo) to send those requests there instead. This only redirects name lookups; the replacement network may also need its own account.</string>
          </property>
         </widget>
        </item>
